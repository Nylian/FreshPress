
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}FreshPress{% endblock %}</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #18344b;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #073b60;
            color: white;
            padding: 22px 15px;
            overflow-y: auto;
            z-index: 1000;
        }           

        .brand {
            text-align: center;
            padding-bottom: 25px;
            border-bottom: 1px solid #315873;
            margin-bottom: 20px;
        }

        .brand img {
            width: 145px;
            height: 115px;
            object-fit: contain;
            background: white;
            border-radius: 10px;
        }

        .brand h2 {
            margin-top: 8px;
            font-size: 21px;
        }

        .brand p {
            font-size: 11px;
            color: #b9d9ed;
            margin-top: 5px;
        }

        .nav-title {
            font-size: 11px;
            color: #9ebed3;
            margin: 18px 12px 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-link {
            display: block;
            position: relative;
            z-index: 1001;
            color: #e3f0f8;
            text-decoration: none;
            padding: 12px;
             margin: 4px 0;
            border-radius: 7px;
            font-size: 13px;
            cursor: pointer;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #176b9e;
            color: white;
        }

        .main {
            margin-left: 250px;
            padding: 28px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .topbar h1 {
            font-size: 25px;
        }

        .topbar p {
            color: #718397;
            font-size: 13px;
            margin-top: 6px;
        }

        .user-info {
            background: white;
            padding: 12px 18px;
            border-radius: 9px;
            font-size: 13px;
            box-shadow: 0 2px 10px #173c5810;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 10px #173c5810;
        }

        .stat-card p {
            color: #718397;
            font-size: 13px;
        }

        .stat-card h2 {
            margin-top: 13px;
            font-size: 27px;
            color: #073b60;
        }

        .section {
            background: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 10px #173c5810;
            margin-bottom: 22px;
        }

        .section h2 {
            font-size: 18px;
            margin-bottom: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th, td {
            padding: 14px 10px;
            text-align: left;
            border-bottom: 1px solid #edf1f5;
        }

        th {
            color: #718397;
            font-weight: 600;
        }

        .status {
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 11px;
            background: #e5f2ff;
            color: #176b9e;
        }

        .welcome {
            background: #0b5684;
            color: white;
            padding: 25px;
            border-radius: 11px;
            margin-bottom: 25px;
        }

        .welcome p {
            margin-top: 8px;
            color: #d5eaf6;
            font-size: 14px;
        }

        @media(max-width: 1000px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media(max-width: 700px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
                padding: 18px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .section {
                overflow-x: auto;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>
    {% block body %}{% endblock %}
</body>
</html>
