
{% extends 'base.html.twig' %}

{% block title %}Payment Management | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>Payment Management</h1>
            <p>Record and monitor customer payments.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="section" style="color:green;">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div class="section">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <h3>Payment Records</h3>
                <p style="color:#718397; font-size:13px; margin-top:5px;">
                    View customer payments and transaction details.
                </p>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <form method="get" action="{{ path('app_payment') }}" style="display:flex; gap:8px;">
                    <input type="text" name="search" value="{{ search }}"
                        placeholder="Search payments..."
                        style="padding:10px; border:1px solid #d5dee8; border-radius:6px;">
                    <button type="submit" class="btn-primary">Search</button>
                </form>

                <a href="{{ path('app_payment_new') }}" class="btn-primary"
                    style="text-decoration:none; padding:10px 14px;">+ Record Payment</a>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr>
                        <th>Payment No.</th>
                        <th>Transaction No.</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Payment Date</th>
                        <th>Reference No.</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in payments %}
                        <tr>
                            <td>{{ payment.paymentNumber }}</td>
                            <td>{{ payment.laundryTransaction.transactionNumber }}</td>
                            <td>
                                {{ payment.laundryTransaction.customer.firstName }}
                                {{ payment.laundryTransaction.customer.lastName }}
                            </td>
                            <td>₱{{ payment.amount|number_format(2) }}</td>
                            <td>{{ payment.paymentMethod }}</td>
                            <td>{{ payment.paymentDate|date('M d, Y h:i A') }}</td>
                            <td>{{ payment.referenceNumber ?: 'â€”' }}</td>
                            <td><span class="status">{{ payment.paymentStatus }}</span></td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" style="text-align:center; padding:25px;">
                                No payment records found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
