
{% extends 'base.html.twig' %}

{% block title %}Record Payment | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>Record Payment</h1>
            <p>Enter customer payment information.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div class="section">
        <form method="post" action="{{ form_action }}">
            <input type="hidden" name="_token" value="{{ csrf_token('payment_create') }}">

            <div style="margin-bottom:18px;">
                <label for="laundryTransaction">Laundry Transaction</label>
                <select id="laundryTransaction" name="laundryTransaction" required
                    style="display:block; width:100%; padding:11px; margin-top:7px; border:1px solid #d5dee8; border-radius:6px;">
                    <option value="">Select a transaction</option>
                    {% for transaction in transactions %}
                        <option value="{{ transaction.id }}">
                            {{ transaction.transactionNumber }} -
                            {{ transaction.customer.firstName }} {{ transaction.customer.lastName }}
                            (₱{{ transaction.totalAmount|number_format(2) }})
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:18px;">
                <label for="amount">Payment Amount (₱)</label>
                <input type="number" id="amount" name="amount" min="0.01" step="0.01"
                    required placeholder="Enter payment amount"
                    style="display:block; width:100%; padding:11px; margin-top:7px; border:1px solid #d5dee8; border-radius:6px;">
            </div>

            <div style="margin-bottom:18px;">
                <label for="paymentMethod">Payment Method</label>
                <select id="paymentMethod" name="paymentMethod" required
                    style="display:block; width:100%; padding:11px; margin-top:7px; border:1px solid #d5dee8; border-radius:6px;">
                    <option value="">Select payment method</option>
                    {% for method in methods %}
                        <option value="{{ method }}">{{ method }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:18px;">
                <label for="paymentStatus">Payment Status</label>
                <select id="paymentStatus" name="paymentStatus" required
                    style="display:block; width:100%; padding:11px; margin-top:7px; border:1px solid #d5dee8; border-radius:6px;">
                    {% for status in statuses %}
                        <option value="{{ status }}" {% if status == 'Completed' %}selected{% endif %}>
                            {{ status }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:18px;">
                <label for="paymentDate">Payment Date and Time</label>
                <input type="datetime-local" id="paymentDate" name="paymentDate" required
                    value="{{ 'now'|date('Y-m-d\\TH:i') }}"
                    style="display:block; width:100%; padding:11px; margin-top:7px; border:1px solid #d5dee8; border-radius:6px;">
            </div>

            <div style="margin-bottom:22px;">
                <label for="referenceNumber">Reference Number (Optional)</label>
                <input type="text" id="referenceNumber" name="referenceNumber"
                    maxlength="100" placeholder="Enter reference number if available"
                    style="display:block; width:100%; padding:11px; margin-top:7px; border:1px solid #d5dee8; border-radius:6px;">
            </div>

            <button type="submit" class="btn-primary">Save Payment</button>
            <a href="{{ path('app_payment') }}" class="btn-secondary"
                style="margin-left:8px;">Cancel</a>
        </form>
    </div>
</div>

{% endblock %}
