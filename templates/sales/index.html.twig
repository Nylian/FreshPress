
{% extends 'base.html.twig' %}

{% block title %}Sales Summary | FreshPress{% endblock %}

{% block body %}
<style>
    .sales-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .sales-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 28px;
    }

    .sales-header h1 {
        margin: 0 0 6px;
        font-size: 28px;
        color: #18344b;
    }

    .sales-header p {
        margin: 0;
        color: #718096;
    }

    .sales-filter {
        background: white;
        padding: 22px;
        border-radius: 12px;
        margin-bottom: 24px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .sales-filter h3 {
        margin: 0 0 18px;
        color: #18344b;
    }

    .filter-fields {
        display: flex;
        align-items: end;
        flex-wrap: wrap;
        gap: 15px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .filter-group label {
        font-size: 13px;
        font-weight: 600;
        color: #526477;
    }

    .filter-group select,
    .filter-group input {
        min-width: 170px;
        padding: 10px 12px;
        border: 1px solid #d7e0e8;
        border-radius: 7px;
        background: white;
        font-size: 14px;
    }

    .filter-button {
        padding: 11px 22px;
        background: #176b9e;
        color: white;
        border: none;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
    }

    .filter-button:hover {
        background: #12577f;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        border-top: 4px solid #176b9e;
    }

    .summary-card.expenses {
        border-top-color: #e59b32;
    }

    .summary-card.profit {
        border-top-color: #21966b;
    }

    .summary-label {
        color: #718096;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .summary-amount {
        font-size: 27px;
        font-weight: 700;
        color: #18344b;
        margin-bottom: 9px;
        overflow-wrap: anywhere;
    }

    .summary-detail {
        font-size: 13px;
        color: #8795a3;
        margin: 0;
    }

    .profit-section {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .profit-section h3 {
        color: #18344b;
        margin: 0 0 20px;
    }

    .profit-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #edf1f5;
    }

    .profit-row span:first-child {
        color: #64748b;
    }

    .profit-row span:last-child {
        font-weight: 600;
        color: #18344b;
    }

    .profit-total {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding-top: 20px;
        margin-top: 5px;
        font-size: 19px;
        font-weight: 700;
    }

    .profit-total span:last-child {
        overflow-wrap: anywhere;
    }

    .report-note {
        margin-top: 18px;
        font-size: 12px;
        color: #8795a3;
    }

    @media (max-width: 850px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .filter-fields {
            align-items: stretch;
            flex-direction: column;
        }

        .filter-group select,
        .filter-group input {
            width: 100%;
            box-sizing: border-box;
        }

        .filter-button {
            width: 100%;
        }

        .profit-total {
            font-size: 16px;
        }
    }
</style>

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="sales-page">

        <div class="sales-header">
            <div>
                <h1>Sales Summary</h1>
                <p>Track your laundry business revenue, expenses, and profit.</p>
            </div>
        </div>

        <div class="sales-filter">
            <h3>Report Filters</h3>

            <form method="get" action="{{ path('app_sales') }}">
                <div class="filter-fields">
                    <div class="filter-group">
                        <label for="period">Reporting Period</label>
                        <select name="period" id="period" onchange="toggleCustomDates()">
                            <option value="all" {{ period == 'all' ? 'selected' : '' }}>All Time</option>
                            <option value="today" {{ period == 'today' ? 'selected' : '' }}>Today</option>
                            <option value="month" {{ period == 'month' ? 'selected' : '' }}>This Month</option>
                            <option value="year" {{ period == 'year' ? 'selected' : '' }}>This Year</option>
                            <option value="custom" {{ period == 'custom' ? 'selected' : '' }}>Custom Range</option>
                        </select>
                    </div>

                    <div id="customDates" style="display: {{ period == 'custom' ? 'flex' : 'none' }}; gap: 15px; flex-wrap: wrap;">
                        <div class="filter-group">
                            <label for="startDate">Start Date</label>
                            <input type="date" name="startDate" id="startDate" value="{{ startDate }}">
                        </div>

                        <div class="filter-group">
                            <label for="endDate">End Date</label>
                            <input type="date" name="endDate" id="endDate" value="{{ endDate }}">
                        </div>
                    </div>

                    <button type="submit" class="filter-button">Apply Filter</button>
                </div>
            </form>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">TOTAL SALES</div>
                <div class="summary-amount">
                    ₱{{ totalSales|number_format(2, '.', ',') }}
                </div>
                <p class="summary-detail">{{ completedPaymentCount }} completed payments</p>
            </div>

            <div class="summary-card expenses">
                <div class="summary-label">TOTAL EXPENSES</div>
                <div class="summary-amount">
                    ₱{{ totalExpenses|number_format(2, '.', ',') }}
                </div>
                <p class="summary-detail">{{ expenseCount }} recorded expenses</p>
            </div>

            <div class="summary-card profit">
                <div class="summary-label">NET PROFIT</div>
                <div class="summary-amount" style="color: {{ netProfit >= 0 ? '#16845b' : '#dc4545' }};">
                    ₱{{ netProfit|number_format(2, '.', ',') }}
                </div>
                <p class="summary-detail">
                    {{ netProfit >= 0 ? 'Positive net profit' : 'Net loss' }}
                </p>
            </div>
        </div>

        <div class="profit-section">
            <h3>Profit Breakdown</h3>

            <div class="profit-row">
                <span>Total Sales</span>
                <span>₱{{ totalSales|number_format(2, '.', ',') }}</span>
            </div>

            <div class="profit-row">
                <span>Less: Total Expenses</span>
                <span>âˆ’ ₱{{ totalExpenses|number_format(2, '.', ',') }}</span>
            </div>

            <div class="profit-total">
                <span>Net Profit</span>
                <span style="color: {{ netProfit >= 0 ? '#16845b' : '#dc4545' }};">
                    ₱{{ netProfit|number_format(2, '.', ',') }}
                </span>
            </div>

            <p class="report-note">
                Sales include completed payments only. Pending and refunded payments are excluded.
                Expenses are based on their recorded expense dates.
            </p>
        </div>

    </div>
</div>

<script>
function toggleCustomDates() {
    const period = document.getElementById('period').value;
    document.getElementById('customDates').style.display =
        period === 'custom' ? 'flex' : 'none';
}
</script>
{% endblock %}
