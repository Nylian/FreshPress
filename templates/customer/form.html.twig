
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | FreshPress{% endblock %}

{% block body %}
{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <h2>{{ page_title }}</h2>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('error') %}
        <div style="background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="section">
        <h3>Customer Information</h3>
        <p>Enter the customer's details below.</p>

        <form method="post" action="{{ form_action }}">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_token) }}">

            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px;">
                <div>
                    <label for="firstName">First Name *</label>
                    <input
                        type="text"
                        id="firstName"
                        name="firstName"
                        value="{{ customer.firstName|default('') }}"
                        required
                        maxlength="100"
                        style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;"
                    >
                </div>

                <div>
                    <label for="lastName">Last Name *</label>
                    <input
                        type="text"
                        id="lastName"
                        name="lastName"
                        value="{{ customer.lastName|default('') }}"
                        required
                        maxlength="100"
                        style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;"
                    >
                </div>

                <div>
                    <label for="phoneNumber">Phone Number *</label>
                    <input
                        type="tel"
                        id="phoneNumber"
                        name="phoneNumber"
                        value="{{ customer.phoneNumber|default('') }}"
                        required
                        maxlength="20"
                        style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;"
                    >
                </div>

                <div>
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ customer.email|default('') }}"
                        maxlength="180"
                        style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;"
                    >
                </div>

                <div style="grid-column: 1 / -1;">
                    <label for="address">Address</label>
                    <textarea
                        id="address"
                        name="address"
                        rows="3"
                        style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;"
                    >{{ customer.address|default('') }}</textarea>
                </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 25px;">
                <button type="submit" class="btn-primary">Save Customer</button>
                <a href="{{ path('app_customer') }}" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
