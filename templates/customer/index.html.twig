
{% extends 'base.html.twig' %}

{% block title %}Customer Management | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>Customer Management</h1>
            <p>Manage and monitor registered customers.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="section" style="color:green;">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div class="section">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <h3>Customer Records</h3>
                <p style="color:#718397; font-size:13px; margin-top:5px;">
                    View, search, and manage customer information.
                </p>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <form method="get" action="{{ path('app_customer') }}" style="display:flex; gap:8px;">
                    <input type="text" name="search" value="{{ search }}"
                        placeholder="Search customers..."
                        style="padding:10px; border:1px solid #d5dee8; border-radius:6px;">
                    <button type="submit" class="btn-primary">Search</button>
                </form>

                <a href="{{ path('app_customer_new') }}" class="btn-primary"
                    style="text-decoration:none; padding:10px 14px;">+ Add Customer</a>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Phone Number</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for customer in customers %}
                        <tr>
                            <td>{{ customer.id }}</td>
                            <td>{{ customer.firstName }} {{ customer.lastName }}</td>
                            <td>{{ customer.phoneNumber }}</td>
                            <td>{{ customer.email ?: 'â€”' }}</td>
                            <td>{{ customer.address ?: 'â€”' }}</td>
                            <td style="white-space:nowrap;">
                                <a href="{{ path('app_customer_edit', {'id': customer.id}) }}"
                                    class="btn-primary"
                                    style="text-decoration:none; padding:7px 10px;">Edit</a>

                                <form method="post"
                                    action="{{ path('app_customer_delete', {'id': customer.id}) }}"
                                    style="display:inline;"
                                    onsubmit="return confirm('Are you sure you want to delete this customer?');">
                                    <input type="hidden" name="_token"
                                        value="{{ csrf_token('delete_customer_' ~ customer.id) }}">
                                    <button type="submit"
                                        style="background:#dc3545; color:white; border:none; padding:7px 10px; border-radius:5px; cursor:pointer;">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align:center; padding:25px;">
                                No customer records found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
