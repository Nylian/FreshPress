
{% extends 'base.html.twig' %}

{% block title %}Dashboard | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">

    <div class="topbar">
        <div>
            <h1>Dashboard</h1>
            <p>Welcome to your FreshPress management system.</p>
        </div>

        <div class="user-info">
            Administrator
        </div>
    </div>

    <div class="welcome">
        <h2>Welcome to FreshPress!</h2>
        <p>Manage your laundry operations efficiently in one place.</p>
    </div>

    <div class="cards">

        <div class="stat-card">
            <p>Total Customers</p>
            <h2>0</h2>
        </div>

        <div class="stat-card">
            <p>Total Orders</p>
            <h2>0</h2>
        </div>

        <div class="stat-card">
            <p>Pending Orders</p>
            <h2>0</h2>
        </div>

        <div class="stat-card">
            <p>Today's Sales</p>
            <h2>₱0.00</h2>
        </div>

    </div>

    <div class="section">
        <h2>Recent Laundry Orders</h2>

        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="5">No laundry orders recorded yet.</td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

{% endblock %}
