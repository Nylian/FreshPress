<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Activity Logs - FreshPress</title>

    <style>


    .brand {
    text-align: center;
    padding-bottom: 25px;
    border-bottom: 1px solid #315873;
    margin-bottom: 20px;
        }

    .brand img {
    width: 145px;
    height: 115px;
    object-fit: contain;
    background: white;
    border-radius: 10px;
    }

    .brand h2 {
    margin-top: 8px;
    font-size: 21px;
    }

    .brand p {
    font-size: 11px;
    color: #b9d9ed;
    margin-top: 5px;
    }
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #18344b;
            font-size: 14px;
        }

        /* SIDEBAR */
        .sidebar {
            width: 250px;
            height: 100vh;
            background: #073b60;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            overflow-y: auto;
        }

        .sidebar h2 {
            margin: 0 0 30px;
            font-size: 24px;
        }

        .nav-title {
            color: #a9c5d8;
            font-size: 11px;
            font-weight: bold;
            margin: 25px 0 10px;
            text-transform: uppercase;
        }

        .nav-link {
            display: block;
            color: white;
            text-decoration: none;
            padding: 11px;
            margin-bottom: 5px;
            border-radius: 5px;
            font-size: 13px;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #176b9e;
        }

        /* MAIN CONTENT */
        .main {
            margin-left: 250px;
            padding: 25px 30px;
        }

        .page-header {
            margin-bottom: 20px;
        }

        .page-header h1 {
            font-size: 27px;
            margin: 0 0 8px;
        }

        .page-header p {
            font-size: 14px;
            color: #64748b;
            margin: 0;
        }

        .content {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }

        .content h2 {
            font-size: 19px;
            margin: 0 0 17px;
        }

        /* SEARCH */
        .search {
            display: flex;
            gap: 8px;
            margin-bottom: 18px;
        }

        .search input {
            width: 300px;
            max-width: 100%;
            padding: 9px 11px;
            border: 1px solid #ccd5df;
            border-radius: 5px;
            font-size: 13px;
        }

        .search button {
            padding: 9px 18px;
            background: #176b9e;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 13px;
            cursor: pointer;
        }

        .search button:hover {
            background: #073b60;
        }

        /* ACTIVITY TABLE */
        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 12px;
        }

        th, td {
            padding: 10px 9px;
            border-bottom: 1px solid #e5eaf0;
            text-align: left;
            line-height: 1.4;
            overflow-wrap: anywhere;
            vertical-align: middle;
        }

        th {
            background: #f1f5f9;
            color: #18344b;
            font-size: 12px;
            font-weight: bold;
        }

        td {
            color: #34495e;
        }

        th:nth-child(1), td:nth-child(1) {
            width: 5%;
            text-align: center;
        }

        th:nth-child(2), td:nth-child(2) {
            width: 13%;
        }

        th:nth-child(3), td:nth-child(3) {
            width: 17%;
        }

        th:nth-child(4), td:nth-child(4) {
            width: 11%;
        }

        th:nth-child(5), td:nth-child(5) {
            width: 39%;
        }

        th:nth-child(6), td:nth-child(6) {
            width: 15%;
        }

        .empty {
            text-align: center;
            padding: 25px;
            color: #718096;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }

            .main {
                margin-left: 200px;
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
{% include 'partials/sidebar.html.twig' %}

    <!-- MAIN CONTENT -->
    <div class="main">

        <div class="page-header">
            <h1>Activity Logs</h1>
            <p>Monitor system activities and user actions.</p>
        </div>

        <div class="content">

            <h2>System Activity History</h2>

            <form method="GET" action="{{ path('app_activity_logs') }}" class="search">
                <input
                    type="text"
                    name="search"
                    placeholder="Search user, action, or description..."
                    value="{{ search }}"
                >
                <button type="submit">Search</button>
            </form>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Date & Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td>{{ log.id }}</td>
                                <td>{{ log.userName }}</td>
                                <td>{{ log.userEmail }}</td>
                                <td>{{ log.action }}</td>
                                <td>{{ log.description ?: '-' }}</td>
                                <td>{{ log.createdAt|date('M d, Y h:i A', 'Asia/Manila') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="empty">
                                    No activity records found.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</body>
</html>
