
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>{{ page_title }}</h1>
            <p>Manage laundry supplies and inventory information.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div class="section" style="max-width:750px;">
        <form method="post" action="{{ form_action }}">

            <input type="hidden" name="_token"
                value="{{ csrf_token(csrf_token) }}">

            <div style="margin-bottom:15px;">
                <label>Item Name</label>
                <input type="text" name="itemName"
                    value="{{ item.itemName ?? '' }}"
                    required maxlength="100"
                    style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
            </div>

            <div style="margin-bottom:15px;">
                <label>Category</label>
                <input type="text" name="category"
                    value="{{ item.category ?? '' }}"
                    required maxlength="100"
                    placeholder="e.g. Cleaning Supplies"
                    style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
            </div>

            <div style="display:flex; gap:15px; flex-wrap:wrap;">
                <div style="flex:1; min-width:200px; margin-bottom:15px;">
                    <label>Quantity</label>
                    <input type="number" name="quantity"
                        value="{{ item.quantity ?? 0 }}"
                        min="0" step="1" required
                        style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                </div>

                <div style="flex:1; min-width:200px; margin-bottom:15px;">
                    <label>Unit</label>
                    <input type="text" name="unit"
                        value="{{ item.unit ?? '' }}"
                        required maxlength="30"
                        placeholder="e.g. Liters, Pieces, Packs"
                        style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                </div>
            </div>

            <div style="display:flex; gap:15px; flex-wrap:wrap;">
                <div style="flex:1; min-width:200px; margin-bottom:15px;">
                    <label>Reorder Level</label>
                    <input type="number" name="reorderLevel"
                        value="{{ item.reorderLevel ?? 0 }}"
                        min="0" step="1" required
                        style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                </div>

                <div style="flex:1; min-width:200px; margin-bottom:15px;">
                    <label>Unit Cost (₱)</label>
                    <input type="number" name="unitCost"
                        value="{{ item.unitCost ?? '' }}"
                        min="0" step="0.01" required
                        style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:15px;">
                <button type="submit" class="btn-primary"
                    style="border:none; padding:11px 18px; cursor:pointer;">
                    Save Item
                </button>

                <a href="{{ path('app_inventory') }}"
                    class="btn-primary"
                    style="text-decoration:none; padding:11px 18px; background:#718397;">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

{% endblock %}
