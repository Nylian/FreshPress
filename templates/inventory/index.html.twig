
{% extends 'base.html.twig' %}

{% block title %}Inventory Management | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>Inventory Management</h1>
            <p>Monitor laundry supplies and stock levels.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="section" style="color:green;">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div style="display:flex; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
        <div class="section" style="flex:1; min-width:180px;">
            <p style="color:#718397;">Total Inventory Items</p>
            <h2>{{ items|length }}</h2>
        </div>

        <div class="section" style="flex:1; min-width:180px;">
            <p style="color:#718397;">Low Stock Items</p>
            <h2 style="color:#dc3545;">{{ lowStockCount }}</h2>
        </div>
    </div>

    <div class="section">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <h3>Inventory Records</h3>
                <p style="color:#718397; font-size:13px; margin-top:5px;">
                    View and manage available laundry supplies.
                </p>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <form method="get" action="{{ path('app_inventory') }}" style="display:flex; gap:8px;">
                    <input type="text" name="search" value="{{ search }}"
                        placeholder="Search inventory..."
                        style="padding:10px; border:1px solid #d5dee8; border-radius:6px;">
                    <button type="submit" class="btn-primary">Search</button>
                </form>

                <a href="{{ path('app_inventory_new') }}" class="btn-primary"
                    style="text-decoration:none; padding:10px 14px;">+ Add Item</a>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Unit</th>
                        <th>Reorder Level</th>
                        <th>Unit Cost</th>
                        <th>Stock Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>{{ item.id }}</td>
                            <td>{{ item.itemName }}</td>
                            <td>{{ item.category }}</td>
                            <td>{{ item.quantity }}</td>
                            <td>{{ item.unit }}</td>
                            <td>{{ item.reorderLevel }}</td>
                            <td>₱{{ item.unitCost|number_format(2) }}</td>
                            <td>
                                {% if item.quantity <= item.reorderLevel %}
                                    <span style="color:#dc3545; font-weight:bold;">Low Stock</span>
                                {% else %}
                                    <span style="color:green; font-weight:bold;">Available</span>
                                {% endif %}
                            </td>
                            <td style="white-space:nowrap;">
                                <a href="{{ path('app_inventory_edit', {'id': item.id}) }}"
                                    class="btn-primary"
                                    style="text-decoration:none; padding:7px 10px;">Edit</a>

                                <form method="post"
                                    action="{{ path('app_inventory_delete', {'id': item.id}) }}"
                                    style="display:inline;"
                                    onsubmit="return confirm('Are you sure you want to delete this inventory item?');">
                                    <input type="hidden" name="_token"
                                        value="{{ csrf_token('delete_inventory_' ~ item.id) }}">
                                    <button type="submit"
                                        style="background:#dc3545; color:white; border:none; padding:7px 10px; border-radius:5px; cursor:pointer;">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" style="text-align:center; padding:25px;">
                                No inventory records found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
