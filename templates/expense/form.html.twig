
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>{{ page_title }}</h1>
            <p>Enter the details of the business expense.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div class="section" style="max-width:750px;">
        <form method="post" action="{{ form_action }}">

            <input type="hidden" name="_token"
                value="{{ csrf_token(csrf_token) }}">

            <div style="margin-bottom:15px;">
                <label>Expense Name</label>
                <input type="text" name="expenseName"
                    value="{{ expense.expenseName ?? '' }}"
                    maxlength="150" required
                    placeholder="e.g. Monthly Electricity Bill"
                    style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
            </div>

            <div style="margin-bottom:15px;">
                <label>Category</label>
                <select name="category" required
                    style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                    <option value="">Select Category</option>
                    {% for category in ['Utilities', 'Supplies', 'Maintenance', 'Rent', 'Salaries', 'Other'] %}
                        <option value="{{ category }}"
                            {% if expense.category == category %}selected{% endif %}>
                            {{ category }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div style="display:flex; gap:15px; flex-wrap:wrap;">
                <div style="flex:1; min-width:200px; margin-bottom:15px;">
                    <label>Amount (₱)</label>
                    <input type="number" name="amount"
                        value="{{ expense.amount ?? '' }}"
                        min="0.01" step="0.01" required
                        style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                </div>

                <div style="flex:1; min-width:200px; margin-bottom:15px;">
                    <label>Expense Date</label>
                    <input type="date" name="expenseDate"
                        value="{{ expense.expenseDate ? expense.expenseDate|date('Y-m-d') : 'now'|date('Y-m-d') }}"
                        required
                        style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">
                </div>
            </div>

            <div style="margin-bottom:15px;">
                <label>Description (Optional)</label>
                <textarea name="description" rows="4"
                    style="width:100%; padding:10px; margin-top:5px; border:1px solid #d5dee8; border-radius:6px;">{{ expense.description ?? '' }}</textarea>
            </div>

            <div style="display:flex; gap:10px; margin-top:15px;">
                <button type="submit" class="btn-primary"
                    style="border:none; padding:11px 18px; cursor:pointer;">
                    Save Expense
                </button>

                <a href="{{ path('app_expense') }}"
                    class="btn-primary"
                    style="text-decoration:none; padding:11px 18px; background:#718397;">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

{% endblock %}
