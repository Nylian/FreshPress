
{% extends 'base.html.twig' %}

{% block title %}Expense Management | FreshPress{% endblock %}

{% block body %}

{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <div>
            <h1>Sales & Expenses</h1>
            <p>Manage and monitor business expenses.</p>
        </div>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="section" style="color:green;">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="section" style="color:red;">{{ message }}</div>
    {% endfor %}

    <div class="section">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <h3>Expense Records</h3>
                <p style="color:#718397; font-size:13px; margin-top:5px;">
                    Record and monitor business expenses.
                </p>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <form method="get" action="{{ path('app_expense') }}" style="display:flex; gap:8px;">
                    <input type="text" name="search" value="{{ search }}"
                        placeholder="Search expenses..."
                        style="padding:10px; border:1px solid #d5dee8; border-radius:6px;">
                    <button type="submit" class="btn-primary">Search</button>
                </form>

                <a href="{{ path('app_expense_new') }}" class="btn-primary"
                    style="text-decoration:none; padding:10px 14px;">+ Record Expense</a>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Expense Name</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Expense Date</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for expense in expenses %}
                        <tr>
                            <td>{{ expense.id }}</td>
                            <td>{{ expense.expenseName }}</td>
                            <td>{{ expense.category }}</td>
                            <td>₱{{ expense.amount|number_format(2) }}</td>
                            <td>{{ expense.expenseDate|date('M d, Y') }}</td>
                            <td>{{ expense.description ?: 'â€”' }}</td>
                            <td style="white-space:nowrap;">
                                <a href="{{ path('app_expense_edit', {'id': expense.id}) }}"
                                    class="btn-primary"
                                    style="text-decoration:none; padding:7px 10px;">Edit</a>

                                <form method="post"
                                    action="{{ path('app_expense_delete', {'id': expense.id}) }}"
                                    style="display:inline;"
                                    onsubmit="return confirm('Are you sure you want to delete this expense?');">
                                    <input type="hidden" name="_token"
                                        value="{{ csrf_token('delete_expense_' ~ expense.id) }}">
                                    <button type="submit"
                                        style="background:#dc3545; color:white; border:none; padding:7px 10px; border-radius:5px; cursor:pointer;">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align:center; padding:25px;">
                                No expense records found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
