
{% extends 'base.html.twig' %}

{% block title %}{{ formTitle }}{% endblock %}

{% block body %}
{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <h1>{{ formTitle }}</h1>
    <p>Enter the user account information below.</p>

    {% for message in app.flashes('error') %}
        <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:6px; margin-bottom:15px;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="background:white; padding:25px; border-radius:10px; max-width:650px;">
        <form method="post">
            <input type="hidden" name="_token"
                   value="{{ csrf_token(user ? 'edit_user_' ~ user.id : 'create_user') }}">

            <div style="margin-bottom:15px;">
                <label>Full Name</label><br>
                <input type="text" name="fullName"
                       value="{{ user.fullName ?? '' }}" required maxlength="255"
                       style="width:100%; padding:10px; box-sizing:border-box;">
            </div>

            <div style="margin-bottom:15px;">
                <label>Email Address</label><br>
                <input type="email" name="email"
                       value="{{ user.email ?? '' }}" required
                       style="width:100%; padding:10px; box-sizing:border-box;">
            </div>

            <div style="margin-bottom:15px;">
                <label>Password {% if user %}(Leave blank to keep current password){% endif %}</label><br>
                <input type="password" name="password"
                       {% if not user %}required{% endif %}
                       minlength="8" autocomplete="new-password"
                       style="width:100%; padding:10px; box-sizing:border-box;">
            </div>

            <div style="margin-bottom:20px;">
                <label>User Role</label><br>
                <select name="role" required style="width:100%; padding:10px;">
                    <option value="ROLE_EMPLOYEE"
                        {% if not user or 'ROLE_EMPLOYEE' in user.roles %}selected{% endif %}>
                        Employee
                    </option>
                    <option value="ROLE_ADMIN"
                        {% if user and 'ROLE_ADMIN' in user.roles %}selected{% endif %}>
                        Administrator
                    </option>
                </select>
            </div>

            <button type="submit"
                    style="background:#176b9e; color:white; padding:11px 20px; border:none; border-radius:6px; cursor:pointer;">
                Save Account
            </button>

            <a href="{{ path('app_user_management') }}" style="margin-left:10px;">
                Cancel
            </a>
        </form>
    </div>
</div>
{% endblock %}
