
{% extends 'base.html.twig' %}

{% block title %}User & Security Management{% endblock %}

{% block body %}
{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <h1>User & Security Management</h1>
    <p>Manage system administrators and employee accounts.</p>

    {% for message in app.flashes('success') %}
        <div style="background:#d4edda; color:#155724; padding:12px; border-radius:6px; margin-bottom:15px;">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:6px; margin-bottom:15px;">
            {{ message }}
        </div>
    {% endfor %}

    <a href="{{ path('app_user_management_new') }}"
       style="display:inline-block; background:#176b9e; color:white; padding:10px 16px; border-radius:6px; text-decoration:none; margin:15px 0;">
        + Add User Account
    </a>

    <div style="background:white; padding:20px; border-radius:10px; overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#eaf1f6;">
                    <th style="padding:12px;">ID</th>
                    <th style="padding:12px;">Full Name</th>
                    <th style="padding:12px;">Email</th>
                    <th style="padding:12px;">Role</th>
                    <th style="padding:12px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td style="padding:12px;">{{ user.id }}</td>
                        <td style="padding:12px;">{{ user.fullName }}</td>
                        <td style="padding:12px;">{{ user.email }}</td>
                        <td style="padding:12px;">
                            {% if 'ROLE_ADMIN' in user.roles %}
                                Administrator
                            {% else %}
                                Employee
                            {% endif %}
                        </td>
                        <td style="padding:12px; white-space:nowrap;">
                            <a href="{{ path('app_user_management_edit', {id: user.id}) }}">Edit</a>

                            {% if user.id != app.user.id %}
                                <form method="post"
                                      action="{{ path('app_user_management_delete', {id: user.id}) }}"
                                      onsubmit="return confirm('Are you sure you want to delete this account?');"
                                      style="display:inline;">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                    <button type="submit"
                                            style="color:red; border:none; background:none; cursor:pointer;">
                                        Delete
                                    </button>
                                </form>
                            {% else %}
                                <span style="color:#888;">Current account</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="padding:20px; text-align:center;">
                            No user accounts found.
                        </td>
                    </tr>
                    
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
