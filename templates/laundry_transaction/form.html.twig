
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | FreshPress{% endblock %}

{% block body %}
{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <h2>{{ page_title }}</h2>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('error') %}
        <div style="background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="section">
        <h3>Transaction Information</h3>
        <p>Enter the laundry transaction details below.</p>

        <form method="post" action="{{ form_action }}" id="transactionForm">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_token) }}">

            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px;">

                <div style="grid-column: 1 / -1;">
                    <label for="customer">Customer *</label>
                    <select id="customer" name="customer" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                        <option value="">Select Customer</option>
                        {% for customer in customers %}
                            <option value="{{ customer.id }}"
                                {% if transaction.customer and transaction.customer.id == customer.id %}selected{% endif %}>
                                {{ customer.firstName }} {{ customer.lastName }} - {{ customer.phoneNumber }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label for="serviceType">Service Type *</label>
                    <select id="serviceType" name="serviceType" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                        <option value="">Select Service</option>
                        {% for service in ['Wash and Fold', 'Wash and Dry', 'Dry Cleaning', 'Ironing'] %}
                            <option value="{{ service }}" {% if transaction.serviceType == service %}selected{% endif %}>
                                {{ service }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label for="weight">Laundry Weight (kg) *</label>
                    <input type="number" id="weight" name="weight" min="0.01" step="0.01" value="{{ transaction.weight|default('') }}" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                </div>

                <div>
                    <label for="pricePerKg">Price per Kilogram (₱) *</label>
                    <input type="number" id="pricePerKg" name="pricePerKg" min="0" step="0.01" value="{{ transaction.pricePerKg|default('') }}" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                </div>

                <div>
                    <label for="totalAmount">Total Amount (₱)</label>
                    <input type="text" id="totalAmount" value="{{ transaction.totalAmount|default('') }}" readonly style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px; background: #f4f7fb;">
                </div>

                {% if transaction.id %}
                    <div>
                        <label for="status">Transaction Status *</label>
                        <select id="status" name="status" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                            {% for status in ['Pending', 'Processing', 'Ready for Pickup', 'Completed', 'Cancelled'] %}
                                <option value="{{ status }}" {% if transaction.status == status %}selected{% endif %}>
                                    {{ status }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

                <div>
                    <label for="dateReceived">Date Received *</label>
                    <input type="date" id="dateReceived" name="dateReceived" value="{{ transaction.dateReceived ? transaction.dateReceived|date('Y-m-d') : 'now'|date('Y-m-d') }}" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                </div>

                <div>
                    <label for="expectedPickupDate">Expected Pickup Date *</label>
                    <input type="date" id="expectedPickupDate" name="expectedPickupDate" value="{{ transaction.expectedPickupDate ? transaction.expectedPickupDate|date('Y-m-d') : '' }}" required style="width: 100%; padding: 10px; margin-top: 7px; border: 1px solid #ccc; border-radius: 5px;">
                </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 25px;">
                <button type="submit" class="btn-primary">Save Transaction</button>
                <a href="{{ path('app_laundry_transaction') }}" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    const weightInput = document.getElementById('weight');
    const priceInput = document.getElementById('pricePerKg');
    const totalInput = document.getElementById('totalAmount');

    function calculateTotal() {
        const weight = parseFloat(weightInput.value) || 0;
        const price = parseFloat(priceInput.value) || 0;
        totalInput.value = (weight * price).toFixed(2);
    }

    weightInput.addEventListener('input', calculateTotal);
    priceInput.addEventListener('input', calculateTotal);

    calculateTotal();
</script>
{% endblock %}
