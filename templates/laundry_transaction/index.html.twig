
{% extends 'base.html.twig' %}

{% block title %}Laundry Transactions | FreshPress{% endblock %}

{% block body %}
{% include 'partials/sidebar.html.twig' %}

<div class="main">
    <div class="topbar">
        <h2>Laundry Transaction Management</h2>
        <div class="user-info">FreshPress Admin</div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background: #d1fae5; color: #065f46; padding: 12px; border-radius: 6px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div style="background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="section">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap; margin-bottom: 20px;">
            <div>
                <h3>Laundry Transaction Records</h3>
                <p>Monitor and manage customer laundry transactions.</p>
            </div>

            <a href="{{ path('app_laundry_transaction_new') }}" class="btn-primary">+ New Transaction</a>
        </div>

        <form method="get" action="{{ path('app_laundry_transaction') }}" style="display: flex; gap: 10px; margin-bottom: 20px;">
            <input
                type="text"
                name="search"
                value="{{ search }}"
                placeholder="Search transaction, customer, service, or status..."
                style="flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 5px;"
            >
            <button type="submit" class="btn-primary">Search</button>
            <a href="{{ path('app_laundry_transaction') }}" class="btn-secondary">Reset</a>
        </form>

        <div style="overflow-x: auto;">
            <table>
                <thead>
                    <tr>
                        <th>Transaction No.</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Weight (kg)</th>
                        <th>Price/kg</th>
                        <th>Total Amount</th>
                        <th>Date Received</th>
                        <th>Expected Pickup</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for transaction in transactions %}
                        <tr>
                            <td>{{ transaction.transactionNumber }}</td>
                            <td>{{ transaction.customer.firstName }} {{ transaction.customer.lastName }}</td>
                            <td>{{ transaction.serviceType }}</td>
                            <td>{{ transaction.weight|number_format(2) }}</td>
                            <td>₱{{ transaction.pricePerKg|number_format(2) }}</td>
                            <td>₱{{ transaction.totalAmount|number_format(2) }}</td>
                            <td>{{ transaction.dateReceived|date('M d, Y') }}</td>
                            <td>{{ transaction.expectedPickupDate|date('M d, Y') }}</td>
                            <td>
                                <span class="status">{{ transaction.status }}</span>
                            </td>
                            <td>
                                <a href="{{ path('app_laundry_transaction_edit', {id: transaction.id}) }}">Edit</a>

                                <form method="post"
                                      action="{{ path('app_laundry_transaction_delete', {id: transaction.id}) }}"
                                      style="display: inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this transaction?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_transaction_' ~ transaction.id) }}">
                                    <button type="submit" style="background: none; border: none; color: #dc2626; cursor: pointer; padding: 5px;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" style="text-align: center; padding: 25px;">
                                No laundry transactions found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
